# Google Photos Discovery Engine - Environment Configuration

# Primary LLM Provider: Groq (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Secondary / Fallback LLM Provider: Google Gemini (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Logging & Debug
PHOTO_ENGINE_LOG_LEVEL=INFO
PHOTO_ENGINE_DEBUG=false
